FROM hk-desktop-pilot-desktop:latest

USER root
RUN apt-get update \
    && apt-get install -y --no-install-recommends firefox-esr \
    && rm -rf /var/lib/apt/lists/*
RUN apt-get update \
    && apt-get install -y --no-install-recommends fonts-noto-cjk \
    && rm -rf /var/lib/apt/lists/*
COPY auth-mimeapps.list /etc/xdg/mimeapps.list
COPY claude-container.desktop /usr/share/applications/claude-container.desktop
RUN install -d -m 0755 -o node -g node /workspace
RUN apt-get update \
    && apt-get install -y --no-install-recommends thunar \
    && rm -rf /var/lib/apt/lists/*
USER node
